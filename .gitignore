# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# local environment files
.env
.env.*
!.env.example

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Database backups (large data files — download via the Diagnostics UI)
artifacts/api-server/backups/*.json

# User-uploaded files — stored in object storage, not source control
artifacts/api-server/uploads/

# Agent working memory — internal development notes, not for repository consumers
.agents/

# Raw AI prompt pastes — development session artifacts, no value to collaborators
attached_assets/Pasted-*.txt

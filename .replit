modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "gbp-schema-drift"

[[workflows.workflow]]
name = "gbp-schema-drift"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && pnpm vitest run src/__tests__/gbp-schema-drift.test.ts"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["google-drive:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 23997
externalPort = 80

[[ports]]
localPort = 24764
externalPort = 3001

[userenv]

[userenv.shared]
BUSINESS_FORWARD_NUMBER = "+12513249090"
TELNYX_FROM_NUMBER = "+12512863200"
TELNYX_CLIENT_NAME = "Bed Bugs & Beyond"
TELNYX_TEXML_APP_ID = "2996119742579737617"
CUSTOM_BBB_GREETING_URL = "https://aiedgesolutions.online/api/audio/bbb-greeting.mp3"
GOOGLE_REVIEW_LINK = "https://g.page/r/CalILM7QsCzSEBM/review"

[userenv.development]
PUBLIC_APP_URL = "https://replit-exportzip-diazpmatt.replit.app"

[userenv.production]
PUBLIC_APP_URL = "https://replit-exportzip-diazpmatt.replit.app"
